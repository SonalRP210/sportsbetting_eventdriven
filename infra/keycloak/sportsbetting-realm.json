{
  "id": "sportsbetting",
  "realm": "sportsbetting",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {"name": "ODDS_READ"},
      {"name": "ODDS_FEED_WRITE"},
      {"name": "ODDS_OPERATIONS"},
      {"name": "ODDS_ADMIN"}
    ]
  },
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "credentials": [{"type": "password", "value": "viewer", "temporary": false}],
      "realmRoles": ["ODDS_READ"]
    },
    {
      "username": "feeder",
      "enabled": true,
      "credentials": [{"type": "password", "value": "feeder", "temporary": false}],
      "realmRoles": ["ODDS_READ", "ODDS_FEED_WRITE"]
    },
    {
      "username": "ops",
      "enabled": true,
      "credentials": [{"type": "password", "value": "ops", "temporary": false}],
      "realmRoles": ["ODDS_READ", "ODDS_OPERATIONS"]
    },
    {
      "username": "admin",
      "enabled": true,
      "credentials": [{"type": "password", "value": "admin", "temporary": false}],
      "realmRoles": ["ODDS_ADMIN", "ODDS_READ", "ODDS_FEED_WRITE", "ODDS_OPERATIONS"]
    }
  ],
  "clients": [
    {
      "clientId": "odds-gateway",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8070/*"],
      "webOrigins": ["+"]
    }
  ]
}
